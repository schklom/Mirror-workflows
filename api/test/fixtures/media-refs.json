    {
      "name": "a hash one character short is not a hash",
      "state": {
        "customEx": [
          {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "image",
              "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "mime": "image/webp",
