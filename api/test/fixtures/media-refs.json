              "size": 1000,
              "width": 800,
              "height": 600,
              "at": 1
            }
          }
        ]
      },
      "expect": []
    },
    {
      "name": "media that is not an object",
      "state": {
        "customEx": [
          {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          {
            "id": "cx2",
            "n": "Sandbag carry cx2",
            "bp": "back",
            "custom": true,
            "media": [
              "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            ]
          }
        ]
      },
      "expect": []
    },
    {
      "name": "each field counts on its own: a good poster under a malformed main hash is kept",
      "state": {
        "customEx": [
          {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "image",
              "hash": "nope",
              "mime": "image/webp",
              "size": 1000,
              "width": 800,
              "height": 600,
              "poster": {
                "hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "mime": "image/webp",
