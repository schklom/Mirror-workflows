{
  "about": "Which blob hashes a state references. api/media.js referencedHashes() and frontend/src/lib/media-refs.js referencedHashes() must both give `expect` (compared as sorted lists) for every `state` here: the server keeps and the client keeps exactly this set. Each of customEx[].media.hash and customEx[].media.poster.hash counts on its own when it matches /^[0-9a-f]{64}$/ — deliberately looser than normalizeMediaRef, because this set decides what is kept.",
  "referencedHashes": [
    {
      "name": "no state at all",
      "state": null,
      "expect": []
    },
    {
      "name": "a state without customEx",
      "state": {
        "unit": "kg"
      },
      "expect": []
    },
    {
      "name": "customEx that is not a list",
      "state": {
        "customEx": {
          "x": {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "image",
              "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "mime": "image/webp",
              "size": 1000,
              "width": 800,
              "height": 600,
              "at": 1
            }
          }
        }
      },
      "expect": []
    },
    {
      "name": "entries that are not exercises are skipped",
      "state": {
        "customEx": [
          null,
          3,
          "cx",
          [],
          {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "image",
              "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "mime": "image/webp",
              "size": 1000,
              "width": 800,
              "height": 600,
              "at": 1
            }
          }
        ]
      },
      "expect": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ]
    },
    {
      "name": "an exercise without media",
      "state": {
        "customEx": [
          {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true
          }
        ]
      },
      "expect": []
    },
    {
      "name": "a photo and its poster",
      "state": {
        "customEx": [
          {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "image",
              "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "mime": "image/webp",
              "size": 1000,
              "width": 800,
              "height": 600,
              "poster": {
                "hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "mime": "image/webp",
                "size": 200,
                "width": 480,
                "height": 360
              },
              "at": 1
            }
          }
        ]
      },
      "expect": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ]
    },
    {
      "name": "a video without a poster",
      "state": {
        "customEx": [
          {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "video",
              "hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
              "mime": "video/mp4",
              "size": 5000000,
              "width": 1920,
              "height": 1080,
              "dur": 12.4,
              "codec": "avc1",
              "at": 1
            }
          }
        ]
      },
      "expect": [
        "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      ]
    },
    {
      "name": "the same file on two exercises counts once",
      "state": {
        "customEx": [
          {
            "id": "cx1",
            "n": "Sandbag carry cx1",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "image",
              "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "mime": "image/webp",
              "size": 1000,
              "width": 800,
              "height": 600,
              "poster": {
                "hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "mime": "image/webp",
                "size": 200,
                "width": 480,
                "height": 360
              },
              "at": 1
            }
          },
          {
            "id": "cx2",
            "n": "Sandbag carry cx2",
            "bp": "back",
            "custom": true,
            "media": {
              "kind": "image",
              "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "mime": "image/webp",
              "size": 1000,
              "width": 800,
              "height": 600,
              "poster": {
                "hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "mime": "image/webp",
                "size": 200,
                "width": 480,
                "height": 360
              },
              "at": 1
            }
          }
        ]
      },
      "expect": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
